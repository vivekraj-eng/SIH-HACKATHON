{
  "expo": {
    "name": "SafePath AI",
    "slug": "safepath-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safepath",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true },
    "android": { "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "ACTIVITY_RECOGNITION"] },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/images/favicon.png" },
    "plugins": ["expo-router", "expo-font", "expo-web-browser", ["expo-location", { "locationAlwaysAndWhenInUsePermission": "SafePath uses your location to detect driving and surface hazards ahead." }]],
    "experiments": { "typedRoutes": true }
  }
}
